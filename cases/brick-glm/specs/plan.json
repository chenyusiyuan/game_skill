  "rawQuery": "做一个像素风打砖块小游戏，玩家左右移动挡板反弹小球，击碎多层砖块获得分数。砖块包含普通砖、双击砖、硬砖和奖励砖，道具包含加长挡板、多球、减速球和穿透球。游戏包含3个关卡，关卡越往后砖块布局越复杂、小球速度越快。需要实现生命、分数、连击、道具掉落、暂停、重新开始、胜负结算，画面用代码绘制挡板、小球、砖块、粒子和UI，不依赖外部素材。",
  "primaryLoop": "玩家左右移动挡板反弹小球，击碎上方多层砖块获得分数；奖励砖掉落道具被挡板接住后生效；球落出底部失去生命；清空砖块进入下一关，3关全清则胜利。",
  "controls": [
    { "input": "ArrowLeft / A", "effect": "挡板向左移动" },
    { "input": "ArrowRight / D", "effect": "挡板向右移动" },
    { "input": "Space", "effect": "发射小球" },
    { "input": "P / Escape", "effect": "暂停 / 继续" },
    { "input": "R", "effect": "游戏结束后重新开始" }
  ],
  "requiredMechanics": [
    { "name": "paddle-movement", "summary": "玩家通过左右方向键或A/D键移动挡板" },
    { "name": "ball-bounce", "summary": "小球根据碰撞角度反弹，碰到墙壁、挡板和砖块时改变方向" },
    { "name": "brick-break", "summary": "砖块被击中后减HP；普通砖1HP、双击砖2HP、硬砖3HP、奖励砖1HP且掉落道具" },
    { "name": "scoring", "summary": "击碎砖块获得分数，连续击碎不碰挡板时连击倍率递增" },
    { "name": "powerup-drop", "summary": "奖励砖被击碎时掉落随机道具：加长挡板、多球、减速球、穿透球" },
    { "name": "powerup-apply", "summary": "挡板接住掉落道具后激活对应效果" },
    { "name": "lives", "summary": "初始3条命，小球落出底部失去1条命，归零则游戏结束" },
    { "name": "levels", "summary": "3个关卡，砖块布局逐关复杂，小球速度逐关加快" },
    { "name": "pause", "summary": "按P或Escape暂停游戏，再按继续" },
    { "name": "win-lose", "summary": "0命时显示失败结算，3关全清显示胜利结算，均可按R或Space重新开始" }
  ],
